/* ── Page layout ─────────────────────────────────────────────── */
.page {
  background: var(--bg-base);
  height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.msg-scroll {
  flex: 1;
  min-height: 0;
}

.msg-list {
  padding: 24rpx 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 0;
}

/* ── Timestamp separator ─────────────────────────────────────── */
.time-sep {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 24rpx 0 8rpx;
}
.time-sep-text {
  font-size: 20rpx;
  color: var(--text-3);
  background: rgba(255,255,255,.06);
  border-radius: 20rpx;
  padding: 4rpx 18rpx;
}

/* ── System message ──────────────────────────────────────────── */
.sys-msg {
  display: flex;
  justify-content: center;
  margin: 8rpx 0;
}
.sys-msg-text {
  font-size: 22rpx;
  color: var(--text-3);
  background: rgba(255,255,255,.05);
  border-radius: 16rpx;
  padding: 6rpx 20rpx;
}

/* ── Message row ─────────────────────────────────────────────── */
.loading-hint { text-align: center; padding: 48rpx 0; }

.msg-row {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.msg-row--mine {
  flex-direction: row-reverse;
}

.msg-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
  background: #1E2235;
}

/* ── Bubble column ───────────────────────────────────────────── */
.bubble-col {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  max-width: 68%;
  gap: 6rpx;
}
.bubble-col--mine {
  align-items: flex-end;
}

.sender-line {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding-left: 4rpx;
}
.sender-name {
  font-size: 22rpx;
  color: var(--text-2);
}
.role-tag {
  font-size: 18rpx;
  border-radius: 8rpx;
  padding: 2rpx 8rpx;
  font-weight: 700;
}
.admin-tag  { background: rgba(255,140,0,.2); color: #FF8C00; }
.hunter-tag { background: rgba(0,229,255,.15); color: #00E5FF; }

/* ── Bubbles ─────────────────────────────────────────────────── */
.bubble {
  border-radius: 24rpx;
  padding: 18rpx 24rpx;
  word-break: break-all;
}
.bubble--other {
  background: #1E2235;
  border: 1rpx solid rgba(255,255,255,.08);
  border-bottom-left-radius: 6rpx;
}
.bubble--mine {
  background: linear-gradient(135deg, #00b8cc, #0090a8);
  border-bottom-right-radius: 6rpx;
}
.bubble-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #fff;
}

/* Image bubble */
.bubble--img {
  padding: 6rpx;
  overflow: hidden;
}
.msg-img {
  width: 320rpx;
  height: 320rpx;
  border-radius: 18rpx;
  display: block;
}

/* ── Input bar ───────────────────────────────────────────────── */
.input-bar {
  background: #121420;
  border-top: 1rpx solid rgba(255,255,255,.07);
  padding-bottom: env(safe-area-inset-bottom);
  flex-shrink: 0;
}

.input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
}

.icon-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 18rpx;
  background: rgba(255,255,255,.05);
}
.icon-btn:active { opacity: .7; }

.chat-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  background: rgba(255,255,255,.07);
  border-radius: 18rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #fff;
  line-height: 72rpx;
}
.input-ph { color: rgba(255,255,255,.3); }

.send-btn {
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: rgba(0,229,255,.15);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background .15s;
}
.send-btn--active {
  background: linear-gradient(135deg, #00b8cc, #0090a8);
}
.send-btn-text {
  font-size: 26rpx;
  color: rgba(255,255,255,.5);
  font-weight: 600;
}
.send-btn--active .send-btn-text { color: #fff; }

/* ── Emoji picker ────────────────────────────────────────────── */
.emoji-picker {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 20rpx;
  gap: 8rpx;
  border-top: 1rpx solid rgba(255,255,255,.06);
}
.emoji-item {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  border-radius: 12rpx;
  background: rgba(255,255,255,.04);
}
.emoji-item:active { background: rgba(0,229,255,.15); }
