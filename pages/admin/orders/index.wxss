.page{background:var(--bg-base);height:100%;min-height:0;display:flex;flex-direction:column;overflow:hidden;box-sizing:border-box;}
.tabs{background:var(--bg-card);border-bottom:1rpx solid var(--border);flex-shrink:0;}
.tab-row{display:inline-flex;padding:0 32rpx;gap:4rpx;}
.tab{display:inline-flex;align-items:center;height:88rpx;padding:0 20rpx;font-size:24rpx;color:var(--text-3);white-space:nowrap;border-bottom:4rpx solid transparent;}
.tab.active{color:var(--primary);border-bottom-color:var(--primary);font-weight:700;}
.list-scroll{flex:1;min-height:0;}
.list{padding:32rpx;display:flex;flex-direction:column;gap:16rpx;}
.order-card{display:flex;flex-direction:column;gap:0;}
.order-card>view:first-child:active{background:var(--bg-hover);}
.order-actions{display:flex;gap:16rpx;margin-top:16rpx;padding-top:16rpx;border-top:1rpx solid var(--border);}
.btn-sm::after{border:none;}
.confirm-row{margin-top:16rpx;padding-top:16rpx;border-top:1rpx solid var(--border);}
.confirm-btn{display:inline-block;background:rgba(0,229,255,.12);color:var(--primary);border:1rpx solid rgba(0,229,255,.3);font-size:26rpx;font-weight:600;padding:10rpx 28rpx;border-radius:999rpx;}
.confirm-btn:active{background:rgba(0,229,255,.25);}
.skeleton-card{height:160rpx;background:linear-gradient(90deg,#1A1D27 25%,#22263A 50%,#1A1D27 75%);background-size:400% 100%;animation:sh 1.5s infinite;border-radius:24rpx;}
@keyframes sh{0%{background-position:100% 0}100%{background-position:-100% 0}}

/* ── 三点下拉菜单 ── */
.dot-menu-wrap { position: relative; }
.dot-menu-icon {
  display: flex; align-items: center; justify-content: center;
  width: 60rpx; height: 60rpx; border-radius: 50%;
  font-size: 36rpx; color: var(--text-3);
}
.dot-menu-icon:active { background: var(--bg-elevated); }
.dot-dropdown {
  position: absolute; right: 0; top: 64rpx;
  background: var(--bg-elevated);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  overflow: hidden;
  min-width: 160rpx;
  z-index: 100;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,.5);
}
.dot-item {
  display: block;
  padding: 22rpx 28rpx;
  font-size: 26rpx;
  color: var(--text-1);
  border-bottom: 1rpx solid var(--border-light);
}
.dot-item:last-child { border-bottom: none; }
.dot-item:active { background: var(--bg-hover); }
.dot-item-danger { color: var(--red); }
