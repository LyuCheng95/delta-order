.admin-page {
  background: var(--bg-base);
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.admin-nav-scroll {
  flex-shrink: 0;
  background: var(--bg-card);
  border-bottom: 1rpx solid var(--border);
  white-space: nowrap;
  width: 100%;
}

.admin-nav-inner {
  display: inline-flex;
  padding: 16rpx 24rpx 20rpx;
  gap: 12rpx;
  vertical-align: top;
}

.admin-nav-chip {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 26rpx;
  font-size: 26rpx;
  color: var(--text-2);
  background: var(--bg-base);
  border: 1rpx solid var(--border);
  border-radius: 999rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.admin-nav-chip.active {
  color: var(--primary);
  border-color: rgba(0, 229, 255, 0.45);
  background: rgba(0, 229, 255, 0.08);
  font-weight: 700;
}

.admin-panel {
  flex: 1;
  min-height: 0;
}

.panel-pad {
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.admin-flex-col {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.admin-list-scroll {
  flex: 1;
  min-height: 0;
}

.sub-tabs .tab-row {
  padding-left: 24rpx;
  padding-right: 24rpx;
}

.tabs {
  background: var(--bg-card);
  border-bottom: 1rpx solid var(--border);
  flex-shrink: 0;
}

.tab-row {
  display: inline-flex;
  padding: 0 8rpx;
  gap: 4rpx;
}

.tab {
  display: inline-flex;
  align-items: center;
  height: 88rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  color: var(--text-3);
  white-space: nowrap;
  border-bottom: 4rpx solid transparent;
}

.tab.active {
  color: var(--primary);
  border-bottom-color: var(--primary);
  font-weight: 700;
}

.list {
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  box-sizing: border-box;
}

.order-card {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.order-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
}
.dot-menu-wrap{position:relative;padding:4rpx 12rpx;}
.dot-menu-icon{font-size:36rpx;color:var(--text-3);line-height:1;letter-spacing:-2rpx;}
.dot-dropdown{position:absolute;right:0;top:52rpx;background:#1E2130;border:1rpx solid var(--border);border-radius:16rpx;min-width:160rpx;z-index:200;box-shadow:0 8rpx 32rpx rgba(0,0,0,.45);overflow:hidden;}
.dot-item{padding:24rpx 32rpx;font-size:28rpx;color:var(--text-1);}
.dot-item:active{background:var(--bg-hover);}
.dot-item-danger{color:#FF4D4F;}

.btn-sm::after {
  border: none;
}

.stack {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.item {
  display: flex;
  flex-direction: column;
}

.sec-title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: var(--text-2);
}

.row-img {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.img-row {
  display: inline-flex;
  gap: 12rpx;
}

.thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.row-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.wallet-tab-bar {
  display: flex;
  flex-shrink: 0;
  border-bottom: 1rpx solid var(--border);
  background: var(--bg-card);
}

.wallet-tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: var(--text-3);
  position: relative;
}

.wallet-tab-active {
  color: var(--primary);
  font-weight: 700;
}

.wallet-tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--primary);
}

.wallet-badge {
  position: absolute;
  top: 12rpx;
  right: 24rpx;
  background: #ff4757;
  color: #fff;
  font-size: 18rpx;
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  text-align: center;
  border-radius: 15rpx;
  padding: 0 6rpx;
}

.wechat-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(0, 229, 255, 0.06);
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
}

.cat-row,
.svc-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.hunter-card {
  display: flex;
  flex-direction: column;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 80rpx 0;
  color: var(--text-3);
}

.empty-icon {
  font-size: 64rpx;
  line-height: 1;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex1 {
  flex: 1;
  min-width: 0;
}

.w-select-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  background: var(--bg-card);
  border-bottom: 1rpx solid var(--border);
  flex-shrink: 0;
}

.w-check {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid var(--border);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.w-check-on {
  background: var(--primary);
  border-color: var(--primary);
}

.w-check-tick {
  font-size: 22rpx;
  color: #000;
  line-height: 1;
  font-weight: 700;
}

.w-card-selected {
  border: 1rpx solid var(--primary) !important;
  background: rgba(0, 229, 255, 0.06) !important;
}

.w-card-partial {
  border: 1rpx solid rgba(0, 229, 255, 0.4) !important;
}

.w-check-partial {
  background: rgba(0, 229, 255, 0.3);
  border-color: var(--primary);
}

.w-batch-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--bg-card);
  border-top: 1rpx solid var(--border);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.25);
  z-index: 100;
}
