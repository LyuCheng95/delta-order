/* shared with service-edit — same token names */
.se-page {
  background: var(--bg-base);
  min-height: 100vh;
  padding: 24rpx 24rpx calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.se-section {
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 28rpx rgba(0,0,0,.35);
}

.se-section-title {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1.5rpx;
  text-transform: uppercase;
  color: var(--primary);
  margin-bottom: 28rpx;
}

.se-field {
  display: flex;
  flex-direction: column;
}
.se-field--switch {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

.se-label {
  font-size: 24rpx;
  color: var(--text-2);
  margin-bottom: 14rpx;
  font-weight: 600;
}
.se-sublabel {
  font-size: 20rpx;
  color: var(--text-3);
  line-height: 1.4;
}

.se-divider {
  height: 1rpx;
  background: var(--border-light);
  margin: 28rpx 0;
}

.se-input {
  background: var(--bg-elevated);
  border: 1rpx solid var(--border);
  border-radius: 14rpx;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text-1);
  box-sizing: border-box;
  width: 100%;
}
.se-icon-input {
  font-size: 40rpx;
  text-align: center;
  letter-spacing: 4rpx;
}

.se-actions {
  display: flex;
  flex-direction: column;
}

.btn::after { border: none; }
