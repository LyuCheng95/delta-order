/* ── Page ── */
.se-page {
  background: var(--bg-base);
  min-height: 100vh;
  padding: 24rpx 24rpx calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ── Section card ── */
.se-section {
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 28rpx rgba(0,0,0,.35);
}

.se-section-title {
  display: block;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: var(--primary);
  margin-bottom: 32rpx;
}

.se-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

/* ── Fields ── */
.se-field {
  display: flex;
  flex-direction: column;
}
.se-field--grow    { flex: 1; min-width: 0; }
.se-field--unit    { width: 160rpx; flex-shrink: 0; }
.se-field--shrink  { flex-shrink: 0; }
.se-field--switch  {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 0;
  min-height: 72rpx;
}

.se-label {
  font-size: 24rpx;
  color: var(--text-2);
  margin-bottom: 14rpx;
  font-weight: 600;
  display: block;
}
/* switch rows: label sits inline, no bottom gap */
.se-field--switch .se-label {
  margin-bottom: 0;
}

.se-sublabel {
  font-size: 20rpx;
  color: var(--text-3);
  line-height: 1.5;
  margin-top: 4rpx;
  display: block;
}

.se-divider {
  height: 1rpx;
  background: var(--border-light);
  margin: 28rpx 0;
}

/* ── Inputs ── */
.se-input {
  background: var(--bg-elevated);
  border: 1rpx solid var(--border);
  border-radius: 14rpx;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text-1);
  box-sizing: border-box;
  width: 100%;
  transition: border-color .15s;
}
.se-input:focus {
  border-color: var(--primary-dim);
}
.se-input.input-sm {
  height: 76rpx;
  font-size: 26rpx;
}
.se-input::placeholder { color: var(--text-3); }

.se-textarea {
  background: var(--bg-elevated);
  border: 1rpx solid var(--border);
  border-radius: 14rpx;
  padding: 24rpx;
  font-size: 26rpx;
  color: var(--text-1);
  width: 100%;
  min-height: 120rpx;
  box-sizing: border-box;
  line-height: 1.6;
}
.se-textarea:focus { border-color: var(--primary-dim); }
.se-textarea::placeholder { color: var(--text-3); }

/* ── Picker ── */
.se-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--bg-elevated);
  border: 1rpx solid var(--border);
  border-radius: 14rpx;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text-1);
  box-sizing: border-box;
}
.se-picker:active { border-color: var(--primary-dim); }
.se-picker--empty { color: var(--text-3); }
.se-picker--sm    { height: 76rpx; font-size: 26rpx; }

.se-picker-arrow {
  font-size: 36rpx;
  color: var(--text-3);
  line-height: 1;
  flex-shrink: 0;
}

/* ── Price row ── */
.se-price-row {
  display: flex;
  align-items: flex-end;
  gap: 0;
}
.se-price-divider { width: 24rpx; flex-shrink: 0; }

.se-price-input-wrap {
  display: flex;
  align-items: center;
  background: var(--bg-elevated);
  border: 1rpx solid var(--border);
  border-radius: 14rpx;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}
.se-price-input-wrap:focus-within { border-color: var(--primary-dim); }

.se-price-input {
  flex: 1;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
  min-width: 0;
}
.se-price-input::placeholder { color: var(--text-3); font-weight: 400; }

/* ── Add field button ── */
.se-add-btn {
  height: 56rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--primary-subtle);
  border: 1rpx solid rgba(0,229,255,.25);
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
}
.se-add-btn:active { background: rgba(0,229,255,.16); border-color: rgba(0,229,255,.4); }

/* ── Empty fields state ── */
.se-fields-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 16rpx;
  gap: 16rpx;
}
.se-fields-empty-icon { font-size: 56rpx; }
.se-fields-empty-text { font-size: 24rpx; color: var(--text-3); }

/* ── Form field card ── */
.se-field-card {
  background: var(--bg-elevated);
  border: 1rpx solid var(--border);
  border-radius: 18rpx;
  padding: 24rpx;
  margin-top: 16rpx;
  position: relative;
  overflow: hidden;
}
.se-field-card::before {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 4rpx;
  background: var(--primary);
  opacity: .5;
  border-radius: 4rpx 0 0 4rpx;
}

.se-field-card-hdr {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.se-field-badge {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--primary);
  background: var(--primary-subtle);
  border: 1rpx solid rgba(0,229,255,.2);
  border-radius: 999rpx;
  padding: 4rpx 20rpx;
  letter-spacing: 1rpx;
}

.se-field-del {
  font-size: 22rpx;
  color: var(--red);
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  background: rgba(255,77,77,.07);
  font-weight: 600;
}
.se-field-del:active { background: rgba(255,77,77,.16); }

/* field-row: type + required side by side, aligned to their labels */
.se-field-row {
  display: flex;
  align-items: flex-start;
  gap: 0;
}
.se-field-row-divider { width: 20rpx; flex-shrink: 0; }

/* required switch inside field-row — keep label above, switch below */
.se-field-row .se-field--switch {
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding: 0;
  min-height: unset;
}
.se-field-row .se-field--switch .se-label {
  margin-bottom: 14rpx;
  text-align: center;
}

/* ── Action buttons ── */
.se-actions {
  padding: 0 0 16rpx;
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}
.se-actions-del  { flex: 0 0 160rpx; }
.se-actions-save { flex: 1; }

.btn::after { border: none; }
