/* ── Page ── */
.se-page {
  background: var(--bg-base);
  min-height: 100vh;
  padding: 24rpx 24rpx calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ── Section card ── */
.se-section {
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 28rpx rgba(0,0,0,.35);
}

.se-section-title {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1.5rpx;
  text-transform: uppercase;
  color: var(--primary);
  margin-bottom: 28rpx;
}

.se-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

/* ── Fields ── */
.se-field {
  display: flex;
  flex-direction: column;
}
.se-field--grow { flex: 1; min-width: 0; }
.se-field--unit { width: 160rpx; flex-shrink: 0; }
.se-field--switch {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}
.se-field--shrink { flex-shrink: 0; align-items: flex-end; }

.se-label {
  font-size: 24rpx;
  color: var(--text-2);
  margin-bottom: 14rpx;
  font-weight: 600;
}
.se-sublabel {
  font-size: 20rpx;
  color: var(--text-3);
  line-height: 1.4;
}

.se-divider {
  height: 1rpx;
  background: var(--border-light);
  margin: 28rpx 0;
}

/* ── Inputs ── */
.se-input {
  background: var(--bg-elevated);
  border: 1rpx solid var(--border);
  border-radius: 14rpx;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text-1);
  box-sizing: border-box;
  width: 100%;
}
.se-input.input-sm { height: 76rpx; font-size: 26rpx; }

.se-textarea {
  background: var(--bg-elevated);
  border: 1rpx solid var(--border);
  border-radius: 14rpx;
  padding: 24rpx;
  font-size: 26rpx;
  color: var(--text-1);
  width: 100%;
  min-height: 120rpx;
  box-sizing: border-box;
  line-height: 1.6;
}

.se-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--bg-elevated);
  border: 1rpx solid var(--border);
  border-radius: 14rpx;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text-1);
  box-sizing: border-box;
}
.se-picker--empty { color: var(--text-3); }
.se-picker--sm { height: 76rpx; font-size: 26rpx; }
.se-picker-arrow {
  font-size: 36rpx;
  color: var(--text-3);
  line-height: 1;
}

/* ── Price row ── */
.se-price-row {
  display: flex;
  align-items: flex-end;
  gap: 0;
}
.se-price-divider {
  width: 24rpx;
  flex-shrink: 0;
}
.se-price-input-wrap {
  display: flex;
  align-items: center;
  background: var(--bg-elevated);
  border: 1rpx solid var(--border);
  border-radius: 14rpx;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}
.se-price-symbol {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--gold);
  margin-right: 8rpx;
  flex-shrink: 0;
}
.se-price-input {
  flex: 1;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
  min-width: 0;
}

/* ── Add field button ── */
.se-add-btn {
  height: 56rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--primary-subtle);
  border: 1rpx solid rgba(0,229,255,.35);
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
}
.se-add-btn:active { background: rgba(0,229,255,.15); }

/* ── Empty fields ── */
.se-fields-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 16rpx;
  gap: 16rpx;
}
.se-fields-empty-icon { font-size: 56rpx; }
.se-fields-empty-text { font-size: 24rpx; color: var(--text-3); }

/* ── Field card ── */
.se-field-card {
  background: var(--bg-elevated);
  border: 1rpx solid var(--border);
  border-radius: 18rpx;
  padding: 24rpx;
  margin-top: 16rpx;
}

.se-field-card-hdr {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.se-field-badge {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--primary);
  background: var(--primary-subtle);
  border: 1rpx solid rgba(0,229,255,.25);
  border-radius: 999rpx;
  padding: 4rpx 20rpx;
  letter-spacing: 1rpx;
}

.se-field-del {
  font-size: 22rpx;
  color: var(--red);
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(255,77,77,.08);
}
.se-field-del:active { background: rgba(255,77,77,.18); }

.se-field-row {
  display: flex;
  align-items: flex-end;
  gap: 0;
}
.se-field-row-divider { width: 20rpx; flex-shrink: 0; }

/* ── Actions ── */
.se-actions {
  padding: 0 0 16rpx;
  display: flex;
  flex-direction: column;
}

.btn::after { border: none; }
