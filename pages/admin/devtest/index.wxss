.dt-page {
  background: var(--bg-base);
  min-height: 100vh;
  padding: 20rpx 24rpx calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ── Banner ── */
.dt-banner {
  background: linear-gradient(135deg, rgba(0,229,255,.12) 0%, rgba(0,180,200,.05) 100%);
  border: 1rpx solid rgba(0,229,255,.2);
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.dt-banner-title { font-size: 32rpx; font-weight: 700; color: var(--primary); }
.dt-banner-sub   { font-size: 22rpx; color: var(--text-3); line-height: 1.5; }

/* ── Sections ── */
.dt-section {
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  padding: 28rpx 28rpx 24rpx;
  margin-bottom: 20rpx;
}

.dt-section-title {
  display: block;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1.5rpx;
  text-transform: uppercase;
  color: var(--primary);
  margin-bottom: 24rpx;
}

.dt-divider { height: 1rpx; background: var(--border-light); margin: 20rpx 0; }

/* ── Step ── */
.dt-step { display: flex; flex-direction: column; gap: 16rpx; }

.dt-step-meta {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.dt-step-num {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--bg-elevated);
  border: 1rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--text-2);
  font-weight: 700;
}

.dt-step-info { display: flex; flex-direction: column; gap: 6rpx; flex: 1; min-width: 0; }
.dt-step-name { font-size: 28rpx; font-weight: 700; color: var(--text-1); }
.dt-step-desc { font-size: 22rpx; color: var(--text-3); line-height: 1.5; }

.dt-step-foot {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  padding-left: 60rpx;
}

/* ── Result pill ── */
.dt-result {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  line-height: 1.4;
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  word-break: break-all;
  color: var(--text-2);
  background: var(--bg-elevated);
  border: 1rpx solid var(--border-light);
}
.dt-result.ok  { color: var(--green);  background: rgba(0,214,143,.06);  border-color: rgba(0,214,143,.2); }
.dt-result.err { color: var(--red);    background: rgba(255,77,77,.06);   border-color: rgba(255,77,77,.2); }

/* ── Buttons ── */
.dt-btn {
  flex-shrink: 0;
  height: 64rpx;
  padding: 0 36rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
  border: none;
  background: var(--primary);
  color: #0A0E18;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.dt-btn::after { border: none; }
.dt-btn:active { opacity: .8; }
.dt-btn[disabled] { background: var(--bg-elevated); color: var(--text-3); }
.dt-btn--ok { background: rgba(0,214,143,.15); color: var(--green); border: 1rpx solid rgba(0,214,143,.35); }
.dt-btn--ok::after { border: none; }

/* ── Section sub label ── */
.dt-section-sub { font-size: 22rpx; color: var(--text-3); line-height: 1.5; }

/* ── Cleanup IDs ── */
.dt-cleanup-ids {
  display: flex; flex-wrap: wrap; gap: 10rpx; margin: 12rpx 0;
}
.dt-id-chip {
  font-size: 20rpx; color: var(--text-2);
  background: var(--bg-elevated);
  border: 1rpx solid var(--border);
  border-radius: 8rpx; padding: 6rpx 16rpx;
  font-family: ui-monospace, monospace;
}
.dt-no-data { font-size: 22rpx; color: var(--text-3); margin: 12rpx 0; }

/* ── Danger button ── */
.dt-btn--danger {
  background: transparent;
  color: var(--red);
  border: 2rpx solid rgba(255,77,77,.5);
  height: 80rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin-top: 8rpx;
}
.dt-btn--danger::after { border: none; }
.dt-btn--danger:active { background: rgba(255,77,77,.08); }
.dt-btn--danger[disabled] { opacity: .4; }

/* ── Log panel ── */
.dt-log-section {
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  padding: 24rpx 24rpx 28rpx;
  margin-bottom: 20rpx;
}
.dt-log-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 18rpx;
}
.dt-log-title {
  font-size: 20rpx; font-weight: 700; letter-spacing: 1.5rpx;
  color: var(--text-3); text-transform: uppercase;
}
.dt-log-clear-btn {
  font-size: 22rpx; color: var(--text-3);
  background: var(--bg-elevated); border-radius: 8rpx;
  padding: 6rpx 16rpx;
}
.dt-log-clear-btn:active { color: var(--text-2); }

.dt-log-empty { font-size: 22rpx; color: var(--text-3); text-align: center; padding: 24rpx 0; }
.dt-log-list {
  display: flex; flex-direction: column; gap: 0;
  max-height: 600rpx; overflow: hidden;
}
.dt-log-item {
  display: flex; gap: 14rpx; align-items: flex-start;
  padding: 9rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}
.dt-log-item:last-child { border-bottom: none; }
.dt-log-time {
  font-size: 20rpx; color: var(--text-3); flex-shrink: 0;
  font-family: ui-monospace, monospace; padding-top: 2rpx;
}
.dt-log-msg {
  font-size: 22rpx; color: var(--text-2); flex: 1; line-height: 1.5;
  word-break: break-all;
}
.dt-log-item.dt-log-ok   .dt-log-msg { color: var(--green); }
.dt-log-item.dt-log-err  .dt-log-msg { color: var(--red); }
.dt-log-item.dt-log-detail .dt-log-msg { color: var(--text-3); font-family: ui-monospace, monospace; font-size: 20rpx; }
