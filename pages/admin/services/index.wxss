/* ── Layout ── */
.page {
  display: flex;
  flex-direction: row;
  height: 100vh;
  background: var(--bg-base);
  overflow: hidden;
  box-sizing: border-box;
}

/* ══ LEFT: category column ══ */
.cat-col {
  width: 200rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  background: var(--bg-card);
  border-right: 1rpx solid var(--border);
}
.cat-scroll { flex: 1; min-height: 0; }

.cat-item {
  display: flex;
  align-items: center;
  padding: 18rpx 8rpx 18rpx 4rpx;
  border-bottom: 1rpx solid var(--border-light);
  position: relative;
}
.cat-item:active { background: var(--bg-hover); }
.cat-item--sel { background: rgba(0,229,255,.08); border-right: 3rpx solid var(--primary); }
.cat-item--drag { opacity: .35; }

.drag-grip {
  flex-shrink: 0;
  width: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 4rpx;
}
.grip-icon { font-size: 22rpx; color: var(--text-3); line-height: 1; }

.cat-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  min-width: 0;
}
.cat-emoji { font-size: 36rpx; line-height: 1; }
.cat-name { font-size: 20rpx; color: var(--text-2); text-align: center; line-height: 1.3; word-break: break-all; }
.cat-name--off { color: var(--text-3); text-decoration: line-through; }
.off-dot { position: absolute; top: 8rpx; right: 6rpx; width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--text-3); }

.col-footer {
  flex-shrink: 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-top: 1rpx solid var(--border);
}
.col-footer:active { background: var(--bg-hover); }

/* ══ RIGHT: service column ══ */
.svc-col { flex: 1; display: flex; flex-direction: column; min-width: 0; overflow: hidden; }

.svc-hdr {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--border);
  background: var(--bg-base);
  gap: 16rpx;
}
.svc-hdr-title { flex: 1; min-width: 0; font-size: 28rpx; color: var(--text-1); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.svc-scroll { flex: 1; min-height: 0; }
.svc-list {
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.svc-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 16rpx 12rpx 16rpx 8rpx;
}
.svc-item--drag { opacity: .35; border-color: rgba(0,229,255,.25); }
.svc-info { flex: 1; min-width: 0; display: flex; flex-direction: column; }

/* ── Empty ── */
.empty-col { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 60rpx 20rpx; }

/* ── Skeletons ── */
.cat-skel { height: 80rpx; margin: 6rpx 8rpx; border-radius: 12rpx; background: linear-gradient(90deg,#1A1D27 25%,#22263A 50%,#1A1D27 75%); background-size: 400% 100%; animation: sh 1.5s infinite; }
.svc-skel { height: 76rpx; border-radius: 16rpx; background: linear-gradient(90deg,#1A1D27 25%,#22263A 50%,#1A1D27 75%); background-size: 400% 100%; animation: sh 1.5s infinite; }
@keyframes sh { 0% { background-position: 100% 0 } 100% { background-position: -100% 0 } }

.btn-sm::after { border: none; }

/* ── Drag ghost ── */
.drag-ghost {
  position: fixed;
  z-index: 9999;
  pointer-events: none;
  display: flex;
  align-items: center;
  gap: 8rpx;
  border-radius: 12rpx;
  background: var(--bg-elevated, #22263A);
  border: 1rpx solid var(--primary);
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,.6);
  opacity: .92;
  padding: 14rpx 12rpx;
}
.drag-ghost--cat {
  left: 8rpx;
  width: 184rpx;
  flex-direction: column;
  gap: 6rpx;
}
.drag-ghost--svc {
  left: calc(200/750 * 100vw + 16rpx);
  right: 16rpx;
}
