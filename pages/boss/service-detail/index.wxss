.page { background: var(--bg-base); height: 100%; display: flex; flex-direction: column; }
.detail-scroll { flex: 1; min-height: 0; }
.content { padding: 32rpx; padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }

/* ── Info card ── */
.info-card {
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
}
.detail-card {
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}
.detail-text { display: block; font-size: 24rpx; color: var(--text-2); line-height: 1.8; word-break: break-all; }

/* ── Form ── */
.form-card { background: var(--bg-card); border-radius: 24rpx; padding: 32rpx; border: 1rpx solid var(--border); margin-bottom: 20rpx; }
.form-item { margin-bottom: 28rpx; }
.form-item:last-child { margin-bottom: 0; }
.form-label { display: block; font-size: 26rpx; color: var(--text-2); margin-bottom: 12rpx; }

/* ── Select group (pill toggle) ── */
.select-group {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.select-opt {
  padding: 14rpx 36rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-2);
  background: var(--bg-elevated);
  border: 1rpx solid var(--border);
}
.select-opt:active { opacity: .75; }
.select-opt.active {
  color: #0A0E18;
  background: var(--primary);
  border-color: var(--primary);
  box-shadow: 0 0 16rpx rgba(0,229,255,.4);
}

/* ── Bottom bar ── */
.bottom-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(15,17,23,.96);
  backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
  border-top: 1rpx solid rgba(255,255,255,.07);
  display: flex; align-items: center; justify-content: space-between;
  box-shadow: 0 -8rpx 32rpx rgba(0,0,0,.4);
}
.order-btn { flex-shrink: 0; min-width: 240rpx; margin: 0; }
.btn::after { border: none; }

/* ── 老板须知 ── */
.rules-card {
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-top: 24rpx;
}
.rules-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.rules-title { font-size: 28rpx; font-weight: 700; color: var(--text-1); }
.rules-arrow  { font-size: 22rpx; color: var(--text-3); }
.rules-body   { margin-top: 20rpx; display: flex; flex-direction: column; gap: 14rpx; }
.rule-item {
  display: block;
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.7;
  word-break: break-all;
}

/* ── Designated hunter ── */
.designated-card {
  border: 1rpx solid rgba(0,229,255,.25);
}
.designated-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 16rpx;
}
.link-text { color: var(--primary); }
.designated-row {
  display: flex; align-items: center; gap: 10rpx;
  padding: 10rpx 0;
}
.designated-add-row {
  padding: 12rpx 0;
  color: var(--primary);
}
.designated-add-row:active { opacity: .7; }
