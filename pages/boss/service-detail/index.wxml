<view class="page">
  <scroll-view scroll-y class="detail-scroll">
    <view wx:if="{{svc}}" class="content">
      <!-- 服务卡 -->
      <view class="info-card">
        <text class="lg bold" style="display:block;margin-bottom:12rpx">{{svc.name}}</text>
        <text class="t2 sm" style="display:block;line-height:1.6;margin-bottom:20rpx">{{svc.description}}</text>
        <view class="row" style="align-items:baseline;gap:6rpx">
          <text class="t2 sm">单价</text>
          <text class="tg bold" style="font-size:48rpx;line-height:1">{{svc.priceZb}}</text>
          <text class="t3 xs"> 总裁贝/{{svc.price_unit}}</text>
        </view>
      </view>

      <!-- 玩法说明（趣味单专用） -->
      <view wx:if="{{svc.detail}}" class="detail-card">
        <text class="detail-text">{{svc.detail}}</text>
      </view>

      <!-- 表单 -->
      <view class="card form-card">
        <text class="md bold" style="display:block;margin-bottom:24rpx">填写订单信息</text>

        <!-- 动态字段 -->
        <block wx:for="{{svc.form_fields}}" wx:key="key">
          <view class="form-item">
            <text class="t2 sm form-label">{{item.label}}<text wx:if="{{item.required}}" style="color:var(--red)"> *</text></text>
            <input wx:if="{{item.type==='text'||item.type==='number'}}" class="input-field" placeholder="请输入{{item.label}}" value="{{formData[item.key]}}" data-key="{{item.key}}" bindinput="onInput"/>
            <view wx:elif="{{item.type==='select'}}" class="select-group">
              <view wx:for="{{item.options}}" wx:key="*this" wx:for-item="opt" class="select-opt {{formSelects[item.key]===opt?'active':''}}" bindtap="onSelect" data-field="{{item.key}}" data-val="{{opt}}">{{opt}}</view>
            </view>
          </view>
        </block>

        <!-- 备注 -->
        <view class="form-item">
          <text class="t2 sm form-label">备注（选填）</text>
          <textarea class="textarea-field" placeholder="有什么特殊要求..." value="{{remark}}" bindinput="onRemark" maxlength="200"/>
        </view>
      </view>
      <!-- 预约时间 -->
      <view class="card time-picker-card">
        <view class="designated-header" bindtap="toggleTimePicker">
          <view class="row" style="align-items:center;gap:12rpx">
            <text class="md bold">🕐 预约时间</text>
            <text wx:if="{{preferredTime}}" class="badge badge-in_progress" style="font-size:20rpx">{{preferredTime}}</text>
            <text wx:else class="t3 xs" style="color:var(--text-3)">选填</text>
          </view>
          <text class="t2 sm" style="color:var(--primary)">{{showTimePicker ? '收起' : '设置'}}</text>
        </view>
        <block wx:if="{{showTimePicker}}">
          <view style="margin-top:20rpx">
            <text class="t2 sm" style="display:block;margin-bottom:12rpx">选择日期</text>
            <view class="row" style="gap:12rpx;flex-wrap:wrap">
              <view wx:for="{{dateOptions}}" wx:key="value"
                class="time-opt {{selectedDate===item.value?'time-opt-active':''}}"
                bindtap="onSelectDate" data-val="{{item.value}}">
                <text class="bold sm">{{item.label}}</text>
                <text class="t3 xs" style="display:block">{{item.sub}}</text>
              </view>
            </view>
          </view>
          <view style="margin-top:20rpx">
            <text class="t2 sm" style="display:block;margin-bottom:12rpx">选择时段</text>
            <view class="row" style="gap:12rpx;flex-wrap:wrap">
              <view wx:for="{{timeSlots}}" wx:key="*this"
                class="time-opt {{selectedTime===item?'time-opt-active':''}}"
                bindtap="onSelectTime" data-val="{{item}}">
                <text class="sm">{{item}}</text>
              </view>
            </view>
          </view>
          <view wx:if="{{preferredTime}}" style="margin-top:20rpx;text-align:right">
            <text class="t3 sm link-text" bindtap="clearPreferredTime">清除预约时间</text>
          </view>
        </block>
      </view>

      <!-- 预约陪玩师 -->
      <view wx:if="{{designatedHunter}}" class="card designated-card">
        <view class="designated-header">
          <text class="md bold">🗓️ 已预约陪玩师</text>
          <text class="t3 xs link-text" bindtap="clearHunter">取消预约</text>
        </view>
        <view class="designated-row">
          <text class="t2 sm">陪玩师：</text>
          <text class="bold sm">{{designatedHunter.nickname}}</text>
        </view>
        <view wx:if="{{needsCoHunter}}" class="designated-row" style="margin-top:4rpx">
          <text class="t2 sm">搭档：</text>
          <text class="t3 sm" style="color:var(--text-3)">接单后由陪玩师自行邀请</text>
        </view>
        <view wx:if="{{designatedTimeSlot}}" class="designated-row" style="margin-top:4rpx">
          <text class="t2 sm">预约时间：</text>
          <text class="bold sm tg">{{designatedTimeSlot}}</text>
        </view>
      </view>

      <!-- 老板须知 -->
      <view class="rules-card" bindtap="toggleRules">
        <view class="rules-header">
          <text class="rules-title">📋 老板须知</text>
          <text class="rules-arrow">{{rulesOpen ? '▲' : '▼'}}</text>
        </view>
        <view wx:if="{{rulesOpen}}" class="rules-body">
          <text class="rule-item">1. 老板阵亡视为炸单，炸单一局加50万保底（对赌单不参与）</text>
          <text class="rule-item">2. 护航单陪玩师必须起五套及以上，不得私藏红金</text>
          <text class="rule-item">3. 陪玩师全部阵亡，老板带出超过100万正常计入保底</text>
          <text class="rule-item">4. 因老板挂机、掉线、跳河等导致撤离失败，最高可视为结单，无售后</text>
          <text class="rule-item">5. 订单未一次打完，再次进行需提前3小时预约原陪玩师</text>
          <text class="rule-item">6. 对赌单内老板故意私藏/丢弃红金，俱乐部有权扣除保底</text>
          <text class="rule-item">7. 出非洲之心、海洋之泪等特殊红，老板自愿加鸡腿 🍗</text>
          <text class="rule-item">8. 陪玩师主动加老板微信可举报，举报成功奖励一单+300R</text>
          <text class="rule-item">9. 所有单结单默认本单无问题，售后请在24小时内联系客服</text>
          <text class="rule-item">10. 陪玩单超时20分钟以上补半价</text>
        </view>
      </view>

      <view style="height:180rpx"/>
    </view>
  </scroll-view>

  <!-- 底部下单栏 -->
  <view class="bottom-bar" wx:if="{{svc}}">
    <view class="col">
      <text class="t2 sm">合计</text>
      <view class="row" style="align-items:baseline;gap:4rpx">
        <text class="tg bold" style="font-size:44rpx;line-height:1">{{totalZb}}</text>
        <text class="t3 xs"> 总裁贝</text>
      </view>
    </view>
    <button class="btn btn-primary order-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">立即下单</button>
  </view>
</view>
