.page { background: var(--bg-base); height: 100%; min-height: 0; display: flex; flex-direction: column; overflow: hidden; box-sizing: border-box; }
.tabs { background: var(--bg-card); border-bottom: 1rpx solid var(--border); flex-shrink: 0; }
.tab-row { display: inline-flex; padding: 0 32rpx; gap: 4rpx; }
.tab { display: inline-flex; align-items: center; height: 88rpx; padding: 0 20rpx; font-size: 24rpx; color: var(--text-3); white-space: nowrap; border-bottom: 4rpx solid transparent; }
.tab.active { color: var(--primary); border-bottom-color: var(--primary); font-weight: 700; }
.list-scroll { flex: 1; min-height: 0; }
.list { padding: 32rpx; display: flex; flex-direction: column; gap: 16rpx; }
.order-card { padding: 28rpx 32rpx; }
.skeleton-card { height: 160rpx; background: linear-gradient(90deg,#1A1D27 25%,#22263A 50%,#1A1D27 75%); background-size: 400% 100%; animation: sh 1.5s infinite; border-radius: 24rpx; }
@keyframes sh { 0%{background-position:100% 0} 100%{background-position:-100% 0} }
