.page { background: var(--bg-base); min-height: 100vh; padding: 32rpx; padding-bottom: calc(80rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.balance-card { background: linear-gradient(135deg,#1a3a6e,#0d1f42); border-radius: 24rpx; padding: 36rpx; margin-bottom: 28rpx; border: 1rpx solid rgba(0,229,255,.2); box-shadow: 0 8rpx 32rpx rgba(0,0,0,.4); }
.balance-label { font-size: 24rpx; color: rgba(255,255,255,.65); }
.balance-amount { font-size: 64rpx; font-weight: 700; color: #fff; letter-spacing: -2rpx; }
.balance-unit { font-size: 24rpx; color: rgba(255,255,255,.7); }
.balance-hint { display: block; font-size: 22rpx; color: rgba(255,255,255,.45); margin-top: 10rpx; }
.tab-bar { display: flex; background: var(--bg-card); border-radius: 16rpx; padding: 6rpx; margin-bottom: 24rpx; gap: 6rpx; border: 1rpx solid var(--border); }
.tab-item { flex: 1; text-align: center; padding: 16rpx 0; border-radius: 12rpx; font-size: 28rpx; color: var(--text-2); }
.tab-active { background: var(--primary); color: #0A0E18; font-weight: 700; }
.preset-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 16rpx; }
.preset-item { text-align: center; padding: 28rpx 0; border: 1rpx solid var(--border); border-radius: 16rpx; font-size: 28rpx; font-weight: 600; color: var(--text-1); background: var(--bg-card); }
.preset-item:active { opacity: .7; }
.preset-selected { border-color: var(--primary); color: var(--primary); background: rgba(0,229,255,.08); }
.input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--bg-elevated);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 0 24rpx;
}
.input-row input { height: 88rpx; flex: 1; font-size: 28rpx; color: var(--text-1); background: transparent; border: none; }
.record-card:active { opacity: .85; }
.record-card { background: var(--bg-card); border-radius: 20rpx; padding: 28rpx 32rpx; margin-bottom: 16rpx; border: 1rpx solid var(--border); }
.empty-tip { text-align: center; color: var(--text-3); padding: 80rpx 0; font-size: 28rpx; }
.btn::after { border: none; }
.section-title { display: block; font-size: 22rpx; color: var(--text-3); font-weight: 700; letter-spacing: 2rpx; text-transform: uppercase; margin: 28rpx 0 16rpx; }
