<view class="page">

  <!-- 余额卡片 -->
  <view class="balance-card">
    <text class="balance-label">💎 总裁贝余额</text>
    <view class="row" style="align-items:baseline;gap:8rpx;margin-top:8rpx">
      <text class="balance-amount">{{balanceZb}}</text>
      <text class="balance-unit">总裁贝</text>
    </view>
    <text class="balance-hint">1 总裁贝 = 1 元人民币</text>
  </view>

  <!-- Tab 切换 -->
  <view class="tab-bar">
    <view class="tab-item {{tab==='recharge'?'tab-active':''}}" bindtap="switchTab" data-tab="recharge">充值</view>
    <view class="tab-item {{tab==='history'?'tab-active':''}}" bindtap="switchTab" data-tab="history">充值记录</view>
  </view>

  <!-- 充值面板 -->
  <block wx:if="{{tab==='recharge'}}">
    <view wx:if="{{platform==='ios' && showIosNotice}}" style="margin-bottom:24rpx;padding:20rpx 24rpx;background:#FFF7E6;border-radius:16rpx;border-left:6rpx solid #FA8C16">
      <text style="font-size:26rpx;color:#AD4E00;line-height:1.6">💡 iOS 端充值含 Apple 服务费，价格上浮 12%。实际到账总裁贝不变。</text>
    </view>
    <view class="card" style="margin-bottom:24rpx">
      <text class="t2 sm" style="display:block;margin-bottom:16rpx;font-weight:600">选择充值金额（总裁贝）</text>
      <view class="preset-grid">
        <view wx:for="{{presets}}" wx:key="*this"
          class="preset-item {{amount===item?'preset-selected':''}}"
          bindtap="selectPreset" data-val="{{item}}">
          {{item}}
        </view>
      </view>
      <view style="margin-top:20rpx">
        <text class="t2 sm" style="display:block;margin-bottom:10rpx">或输入金额</text>
        <view class="input-row">
          <input class="input-field" type="digit" placeholder="最少充值 100" value="{{customAmount}}"
            bindinput="onCustomInput" style="flex:1"/>
          <text class="t2 sm" style="margin-left:12rpx;white-space:nowrap">总裁贝</text>
        </view>
      </view>
    </view>

    <button class="btn btn-primary" style="width:100%" loading="{{paying}}" bindtap="doRecharge">
      微信支付充值（{{displayAmount}} 总裁贝）
    </button>
  </block>

  <!-- 充值记录 -->
  <block wx:if="{{tab==='history'}}">
    <view wx:if="{{records.length===0}}" class="empty-tip">暂无充值记录</view>
    <view wx:for="{{records}}" wx:key="_id" class="record-card">
      <view class="row" style="justify-content:space-between;align-items:center;margin-bottom:8rpx">
        <text class="bold">{{item.amount_zb}} 总裁贝</text>
        <text class="badge badge-{{item.status==='approved'?'completed':item.status==='rejected'?'cancelled':'paid'}}">{{item.statusLabel}}</text>
      </view>
      <text class="t2 sm" style="display:block;margin-top:4rpx">{{item.timeStr}}</text>
    </view>
  </block>

</view>
