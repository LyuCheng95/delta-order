.page { background: var(--bg-base); min-height: 100vh; box-sizing: border-box; display: flex; flex-direction: column; }

/* ── 搜索栏 ── */
.search-bar {
  display: flex; align-items: center; gap: 16rpx;
  background: var(--bg-card); border-radius: 999rpx;
  padding: 16rpx 28rpx; margin: 20rpx 24rpx 16rpx;
  border: 1rpx solid var(--border);
}
.search-icon { font-size: 28rpx; }
.search-input { flex: 1; font-size: 28rpx; color: var(--text-1); }

/* ── 选搭档 banner ── */
.select-mode-banner {
  background: rgba(0,229,255,.08); border: 1rpx solid rgba(0,229,255,.25);
  border-radius: 16rpx; padding: 20rpx 28rpx; margin: 16rpx 24rpx 0;
}

/* ── 双列网格 ── */
.grid-scroll { flex: 1; }
.hunter-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 16rpx; padding: 0 24rpx 16rpx;
}

/* ── 卡片 ── */
.hunter-card {
  background: var(--bg-card); border-radius: 24rpx;
  padding: 24rpx 20rpx; border: 1rpx solid var(--border);
  display: flex; flex-direction: column; gap: 10rpx;
}
.hunter-card:active { opacity: .8; }

.avatar-wrap { position: relative; align-self: center; margin-bottom: 4rpx; }
.avatar {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  border: 3rpx solid rgba(255,255,255,.12); display: block;
}
.affinity-dot {
  position: absolute; bottom: 0; right: -8rpx;
  background: rgba(255,80,80,.85); border-radius: 999rpx;
  font-size: 18rpx; color: #fff; padding: 2rpx 10rpx;
  white-space: nowrap;
}

.name-row { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; }
.name-text { font-size: 28rpx; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.count-badge {
  background: rgba(0,229,255,.1); border: 1rpx solid rgba(0,229,255,.2);
  border-radius: 999rpx; font-size: 20rpx; color: var(--primary);
  padding: 2rpx 12rpx; flex-shrink: 0;
}

.play-style { font-size: 22rpx; color: var(--primary); display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.bio { font-size: 22rpx; color: var(--text-3); line-height: 1.5; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }

.tag-row { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 4rpx; }
.tag {
  background: rgba(255,255,255,.06); border: 1rpx solid var(--border);
  border-radius: 8rpx; font-size: 20rpx; color: var(--text-2);
  padding: 4rpx 12rpx;
}

/* ── 骨架 ── */
.skeleton-card { height: 280rpx; background: var(--bg-card); border-radius: 24rpx; opacity: .6; }

/* ── 空 ── */
.empty { display: flex; flex-direction: column; align-items: center; gap: 16rpx; padding: 120rpx 0; }
.empty-icon { font-size: 80rpx; }
