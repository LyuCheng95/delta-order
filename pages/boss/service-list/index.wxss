.page { background: var(--bg-base); height: 100vh; display: flex; flex-direction: column; box-sizing: border-box; }

/* ── 指定陪玩师横幅 ── */
.hunter-banner {
  flex-shrink: 0; background: var(--primary); color: #fff;
  font-size: 26rpx; font-weight: 600; text-align: center;
  padding: 18rpx 32rpx;
}

/* ── 分类 tab ── */
.cat-bar { flex-shrink: 0; background: var(--bg-card); border-bottom: 1rpx solid var(--border); white-space: nowrap; }
.cat-inner { display: inline-flex; padding: 0 16rpx; gap: 8rpx; }
.cat-item {
  display: inline-flex; align-items: center; height: 88rpx;
  padding: 0 28rpx; font-size: 26rpx; color: var(--text-3);
  border-bottom: 4rpx solid transparent; white-space: nowrap;
}
.cat-active { color: var(--primary); border-bottom-color: var(--primary); font-weight: 700; }

/* ── 服务列表 ── */
.svc-scroll { flex: 1; }
.section-header {
  font-size: 24rpx; font-weight: 700; color: var(--text-3);
  padding: 28rpx 32rpx 12rpx; letter-spacing: 1rpx; text-transform: uppercase;
}
.svc-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 16rpx; padding: 0 24rpx 8rpx;
}
.svc-card {
  background: var(--bg-card); border-radius: 20rpx;
  padding: 28rpx 24rpx; border: 1rpx solid var(--border);
  display: flex; flex-direction: column; gap: 10rpx;
  active-opacity: 0.8;
}
.svc-card:active { opacity: .75; }
.svc-name { font-size: 28rpx; line-height: 1.4; color: var(--text-1); }
.svc-desc { font-size: 22rpx; color: var(--text-3); line-height: 1.5; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.svc-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 8rpx; }
.price-row { display: flex; align-items: baseline; gap: 2rpx; }
.price-unit { font-size: 22rpx; color: var(--gold); }
.price-num { font-size: 36rpx; font-weight: 700; color: var(--gold); line-height: 1; }
.price-per { font-size: 20rpx; color: var(--text-3); }
.order-btn { font-size: 22rpx; color: var(--primary); font-weight: 600; }

/* ── 骨架 ── */
.skeleton-card { height: 160rpx; background: var(--bg-card); border-radius: 20rpx; margin: 16rpx 24rpx 0; opacity: .6; }

/* ── 空 ── */
.empty { display: flex; flex-direction: column; align-items: center; gap: 16rpx; padding: 120rpx 0; }
.empty-icon { font-size: 80rpx; }
