<view class="page">
  <view wx:if="{{order}}" class="content">

    <!-- 金额卡 -->
    <view class="amount-card">
      <text class="amount-label">应付金额</text>
      <view class="amount-row">
        <text class="amount-num">{{order.totalYuan}}</text>
        <text class="amount-unit">总裁贝</text>
      </view>
      <view class="amount-no">订单号：{{order.order_no}}</view>
    </view>

    <!-- 订单信息 -->
    <view class="card">
      <text class="t2 sm" style="display:block;margin-bottom:16rpx">订单信息</text>
      <view class="info-row"><text class="t2 sm">服务</text><text class="bold">{{order.service_snapshot.service_name}}</text></view>
      <view wx:if="{{order.remark}}" class="divider"/>
      <view wx:if="{{order.remark}}" class="info-row"><text class="t2 sm">备注</text><text class="sm flex1" style="text-align:right">{{order.remark}}</text></view>
    </view>


  </view>

  <!-- 底部操作 -->
  <view class="bottom-bar">
    <button class="btn btn-primary" style="width:100%" loading="{{paying}}" bindtap="onWxPay">微信支付 {{order.totalYuan}} 总裁贝</button>
    <button class="btn btn-ghost" style="width:100%;margin-top:12rpx" bindtap="onCancel">取消订单</button>
  </view>
</view>
