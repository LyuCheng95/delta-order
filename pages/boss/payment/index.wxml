<view class="page">
  <view wx:if="{{order}}" class="content">

    <!-- 金额卡 -->
    <view class="amount-card">
      <text class="amount-label">应付金额</text>
      <view class="amount-row">
        <text class="amount-num">{{order.totalYuan}}</text>
        <text class="amount-unit">总裁贝</text>
      </view>
      <view class="amount-no">订单号：{{order.order_no}}</view>
    </view>

    <!-- 订单信息 -->
    <view class="card">
      <text class="t2 sm" style="display:block;margin-bottom:16rpx">订单信息</text>
      <view class="info-row"><text class="t2 sm">服务</text><text class="bold">{{order.service_snapshot.service_name}}</text></view>
      <view wx:if="{{order.remark}}" class="divider"/>
      <view wx:if="{{order.remark}}" class="info-row"><text class="t2 sm">备注</text><text class="sm flex1" style="text-align:right">{{order.remark}}</text></view>
    </view>

    <!-- 总裁贝余额 -->
    <view class="card" style="margin-top:20rpx">
      <view class="info-row" style="margin-bottom:0">
        <text class="t2 sm">💎 总裁贝余额</text>
        <text class="bold {{sufficient?'':'text-danger'}}">{{balanceZb}} 总裁贝</text>
      </view>
      <view wx:if="{{!sufficient}}" style="margin-top:16rpx;display:flex;align-items:center;gap:16rpx">
        <text class="t2 sm" style="color:#ff4d4d;flex:1">余额不足，请先充值</text>
        <view class="btn-sm btn-primary" bindtap="goRecharge">去充值</view>
      </view>
    </view>

  </view>

  <!-- 底部操作 -->
  <view class="bottom-bar">
    <button
      class="btn btn-primary"
      style="width:100%"
      loading="{{paying}}"
      disabled="{{!sufficient}}"
      bindtap="onPayWithBalance"
    >
      {{sufficient ? '使用 ' + order.totalYuan + ' 总裁贝 支付' : '总裁贝余额不足'}}
    </button>
    <button class="btn btn-ghost" style="width:100%;margin-top:12rpx" bindtap="onCancel">取消订单</button>
  </view>
</view>
