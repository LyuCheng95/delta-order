.page {
  background: var(--bg-base);
  height: 100%;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}
.content {
  flex: 1;
  overflow-y: auto;
  padding: 32rpx;
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ── Amount card ── */
.amount-card {
  text-align: center;
  padding: 56rpx 32rpx 48rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(145deg, #0d1f3d 0%, #111827 100%);
  border: 1rpx solid rgba(0,229,255,.2);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,.4), inset 0 1rpx 0 rgba(0,229,255,.12);
}
.amount-label {
  font-size: 24rpx;
  color: var(--text-3);
  display: block;
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
}
.amount-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 6rpx;
  margin-bottom: 16rpx;
}
.amount-unit {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--gold);
}
.amount-num {
  font-size: 96rpx;
  font-weight: 900;
  color: var(--gold);
  letter-spacing: -3rpx;
  line-height: 1;
}
.amount-no {
  font-size: 22rpx;
  color: var(--text-3);
  letter-spacing: 1rpx;
}

/* ── Info rows ── */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-light);
  font-size: 28rpx;
}
.info-row:last-child { border-bottom: none; }

/* ── Bottom bar ── */
.bottom-bar {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: rgba(15,17,23,.96);
  backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
  border-top: 1rpx solid rgba(255,255,255,.07);
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 32rpx rgba(0,0,0,.4);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.btn::after { border: none; }
