<view class="page">
<scroll-view scroll-y class="page-scroll">

  <!-- 总裁贝名片 -->
  <view class="zc-card">
    <!-- 顶行：头像 + 昵称 + VIP徽章 -->
    <view class="zc-top">
      <!-- 头像（可点击换头像） -->
      <view class="avatar-wrap" bindtap="onEditAvatar">
        <image class="avatar" src="{{avatarUrl}}" mode="aspectFill"/>
        <view class="avatar-pencil">✏️</view>
      </view>
      <!-- 昵称（可点击改名） -->
      <view class="col" style="gap:6rpx;flex:1;min-width:0" bindtap="openEditNickname">
        <view class="row" style="align-items:center;gap:8rpx">
          <text class="lg bold" style="color:#fff">{{nickname}}</text>
          <text style="font-size:24rpx;opacity:.7">✏️</text>
        </view>
        <view class="row" style="gap:8rpx;flex-wrap:wrap">
          <text class="badge badge-paid">玩家</text>
          <text wx:if="{{isHunter}}" class="badge badge-in_progress">陪玩师</text>
          <text wx:if="{{isAdmin}}" class="badge badge-completed">管理员</text>
        </view>
      </view>
      <view wx:if="{{vipLevel>0}}" class="vip-badge vip-badge-{{vipLevel}}">VIP{{vipLevel}}</view>
    </view>

    <!-- 分割线 -->
    <view class="zc-divider"/>

    <!-- 余额行 -->
    <view class="zc-balance-row">
      <view class="col" style="gap:6rpx">
        <text class="zc-label">💎 总裁贝余额</text>
        <view class="row" style="align-items:baseline;gap:8rpx">
          <text class="zc-amount">{{balanceZb}}</text>
          <text class="zc-unit">总裁贝</text>
        </view>
      </view>
      <view class="col" style="gap:6rpx;align-items:flex-end">
        <text class="zc-label">累计消费</text>
        <text class="zc-spent">{{spentZb}} 总裁贝</text>
      </view>
    </view>

    <!-- VIP 进度条 -->
    <view wx:if="{{vipLevel<3}}" class="zc-progress-wrap">
      <view class="zc-progress-bar">
        <view class="zc-progress-fill" style="width:{{vipProgress}}%"/>
      </view>
      <text class="zc-progress-tip">{{vipTip}}</text>
    </view>
    <view wx:else class="zc-progress-wrap">
      <text class="zc-progress-tip" style="color:var(--primary)">🏆 顶级 VIP3，感谢您的信任！</text>
    </view>

    <!-- 操作按钮 -->
    <view class="zc-actions">
      <view class="zc-btn-primary" bindtap="goRecharge">+ 充值</view>
      <view class="zc-btn-ghost" bindtap="goRechargeHistory">充值记录</view>
    </view>
  </view>

  <!-- 身份切换：满足角色即可进入对应端 -->
  <block wx:if="{{isHunter || isAdmin}}">
    <text class="t2 sm sec">身份切换</text>
    <view wx:if="{{isHunter}}" class="card menu-item" bindtap="goHunterLogin">
      <view class="row" style="gap:20rpx;flex:1">
        <text style="font-size:52rpx">🎮</text>
        <view class="col" style="gap:6rpx">
          <text class="bold">陪玩师登录</text>
          <text class="t2 sm" style="line-height:1.4">进入陪玩工作台，接单与收入</text>
        </view>
      </view>
      <text class="t3" style="font-size:40rpx">›</text>
    </view>
    <view wx:if="{{isAdmin}}" class="card menu-item" bindtap="goAdmin">
      <view class="row" style="gap:20rpx;flex:1">
        <text style="font-size:52rpx">🛡️</text>
        <view class="col" style="gap:6rpx">
          <text class="bold">管理登录</text>
          <text class="t2 sm" style="line-height:1.4">订单、服务、陪玩师审核等</text>
        </view>
      </view>
      <text class="t3" style="font-size:40rpx">›</text>
    </view>
  </block>

  <!-- 尚未成为陪玩师：申请流程 -->
  <block wx:if="{{!isHunter}}">
    <text class="t2 sm sec">陪玩师功能</text>
    <view class="card menu-item" bindtap="onHunterEntry">
      <view class="row" style="gap:20rpx;flex:1">
        <text style="font-size:52rpx">📝</text>
        <view class="col" style="gap:6rpx">
          <text class="bold">{{hunterTitle}}</text>
          <text class="t2 sm" style="line-height:1.4">{{hunterDesc}}</text>
        </view>
      </view>
      <text class="t3" style="font-size:40rpx">›</text>
    </view>
  </block>

  <!-- 联系方式 -->
  <text class="t2 sm sec" style="margin-top:32rpx">联系方式</text>
  <view class="card menu-item" bindtap="openEditContact">
    <view class="row" style="gap:20rpx;flex:1">
      <text style="font-size:52rpx">📞</text>
      <view class="col" style="gap:6rpx">
        <text class="bold">微信号 / 手机号</text>
        <text class="t2 sm" style="line-height:1.4">{{contact || '未填写，管理员下单后无法联系你'}}</text>
      </view>
    </view>
    <text class="t3" style="font-size:40rpx">›</text>
  </view>

  <!-- 更多 -->
  <text class="t2 sm sec" style="margin-top:32rpx">更多</text>
  <view class="card menu-list">
    <view class="menu-row" bindtap="onAbout"><text>关于平台</text><text class="t3">›</text></view>
  </view>

</scroll-view>
</view>

<!-- 昵称编辑弹窗 -->
<view class="mask" wx:if="{{editingNickname}}" bindtap="closeEditNickname"/>
<view class="sheet {{editingNickname?'sheet-show':''}}">
  <text class="lg bold" style="display:block;margin-bottom:8rpx">修改昵称</text>
  <text class="t2 sm" style="display:block;margin-bottom:24rpx;line-height:1.6">昵称将显示在订单中</text>
  <input class="input-field" placeholder="输入新昵称" value="{{nicknameDraft}}" bindinput="onNicknameInput" maxlength="20"/>
  <button class="btn btn-primary" style="width:100%;margin-top:24rpx" loading="{{savingNickname}}" bindtap="saveNickname">保存</button>
  <button class="btn btn-ghost" style="width:100%;margin-top:12rpx" bindtap="closeEditNickname">取消</button>
</view>

<!-- 联系方式编辑弹窗 -->
<view class="mask" wx:if="{{editingContact}}" bindtap="closeEditContact"/>
<view class="sheet {{editingContact?'sheet-show':''}}">
  <text class="lg bold" style="display:block;margin-bottom:8rpx">填写联系方式</text>
  <text class="t2 sm" style="display:block;margin-bottom:24rpx;line-height:1.6">管理员看到订单后可通过此方式联系你（微信号或手机号均可）</text>
  <input class="input-field" placeholder="填写微信号或手机号" value="{{contactDraft}}" bindinput="onContactInput" maxlength="50"/>
  <button class="btn btn-primary" style="width:100%;margin-top:24rpx" loading="{{savingContact}}" bindtap="saveContact">保存</button>
  <button class="btn btn-ghost" style="width:100%;margin-top:12rpx" bindtap="closeEditContact">取消</button>
</view>

<!-- 申请弹窗 -->
<view class="mask" wx:if="{{showApply}}" bindtap="closeApply"/>
<view class="sheet {{showApply?'sheet-show':''}}">
  <text class="lg bold" style="display:block;margin-bottom:12rpx">申请成为陪玩师</text>
  <text class="t2 sm" style="display:block;margin-bottom:24rpx;line-height:1.6">填写游戏信息，管理员审核通过后即可接单</text>
  <text class="t2 sm" style="display:block;margin-bottom:10rpx">陪玩师昵称（接单时显示）</text>
  <input class="input-field" style="margin-bottom:20rpx" placeholder="取一个响亮的名字..." value="{{hunterNickname}}" bindinput="onNickInput" maxlength="20"/>
  <text class="t2 sm" style="display:block;margin-bottom:10rpx">微信号 <text style="color:#ff4d4f">*</text>（审核通过后管理员会联系你）</text>
  <input class="input-field" style="margin-bottom:20rpx" placeholder="填写你的微信号或手机号" value="{{hunterWechat}}" bindinput="onWechatInput" maxlength="50"/>
  <text class="t2 sm" style="display:block;margin-bottom:10rpx">申请说明</text>
  <textarea class="textarea-field" placeholder="游戏ID、段位、擅长模式..." value="{{applyReason}}" bindinput="onApplyInput" maxlength="200"/>
  <text class="t2 sm" style="display:block;margin-top:20rpx;margin-bottom:6rpx">自我介绍 <text class="t3 xs"style="color:var(--text-3)">（选填）</text></text>
  <textarea class="textarea-field" placeholder="介绍你的风格、擅长内容…填写后老板更容易指定你 💪" value="{{applyBio}}" bindinput="onApplyBioInput" maxlength="100" style="min-height:120rpx"/>
  <text class="t3 xs" style="display:block;margin-top:8rpx;margin-bottom:20rpx;color:var(--text-3)">📌 简介和服务偏好可以登录后在「我的」页完善，填得越详细越容易被老板指定</text>
  <button class="btn btn-primary" style="width:100%;margin-top:4rpx" loading="{{applying}}" bindtap="submitApply">提交申请</button>
  <button class="btn btn-ghost" style="width:100%;margin-top:12rpx" bindtap="closeApply">取消</button>
</view>
