<view class="page">
  <scroll-view scroll-y class="detail-scroll">
    <view wx:if="{{order}}" class="content">
      <!-- 状态区 -->
      <view class="status-hero">
        <view class="status-dot dot-{{order.status}}"/>
        <text class="xl bold">{{order.statusLabel}}</text>
        <text class="t3 xs">{{order.order_no}}</text>
      </view>

      <!-- 服务信息 -->
      <view class="card">
        <text class="t2 sm sec-title">服务详情</text>
        <view class="info-row"><text class="t2 sm">服务</text><text class="bold">{{order.service_snapshot.service_name}}</text></view>
        <view class="divider"/>
        <view class="info-row"><text class="t2 sm">分类</text><text>{{order.service_snapshot.category_name}}</text></view>
        <view class="divider"/>
        <view class="info-row"><text class="t2 sm">金额</text><text class="tg bold" style="font-size:32rpx">{{order.totalZb}} 总裁贝</text></view>
        <block wx:if="{{order.hunter_display}}">
          <view class="divider"/>
          <view class="info-row">
            <text class="t2 sm">本单陪玩师</text>
            <view class="flex1" style="text-align:right">
              <text class="sm">{{order.hunter_display.nickname}}</text>
              <text class="t3 xs"> · ···{{order.hunter_display.openid_tail}}</text>
            </view>
          </view>
        </block>
      </view>

      <view class="card" wx:if="{{order.formRows.length || order.remark}}">
        <text class="t2 sm sec-title">玩家下单信息</text>
        <text class="t3 xs" style="display:block;margin-bottom:16rpx;color:rgba(255,255,255,.45)">含游戏 ID、房间号、端游/手游等，请与游戏内一致</text>
        <block wx:for="{{order.formRows}}" wx:key="key">
          <view wx:if="{{index>0}}" class="divider"/>
          <view class="info-row"><text class="t2 sm">{{item.label}}</text><text class="sm flex1" style="text-align:right;word-break:break-all">{{item.value}}</text></view>
        </block>
        <view wx:if="{{order.remark}}" class="divider"/>
        <view wx:if="{{order.remark}}" class="info-row"><text class="t2 sm">备注</text><text class="sm flex1" style="text-align:right;word-break:break-all">{{order.remark}}</text></view>
      </view>

      <!-- 预约时间 -->
      <view wx:if="{{order.preferred_time}}" class="card">
        <view class="info-row">
          <text class="t2 sm">🕐 预约时间</text>
          <text class="bold" style="color:#ffd700">{{order.preferred_time}}</text>
        </view>
      </view>

      <view class="card" wx:if="{{order.proofUrls.length}}">
        <text class="t2 sm sec-title">陪玩师完成截图</text>
        <scroll-view scroll-x style="width:100%;white-space:nowrap">
          <view style="display:inline-flex;gap:12rpx">
            <image
              wx:for="{{order.proofUrls}}"
              wx:key="*this"
              wx:for-item="pic"
              wx:for-index="pix"
              src="{{pic}}"
              style="width:200rpx;height:200rpx;border-radius:12rpx;flex-shrink:0"
              mode="aspectFill"
              bindtap="previewImg"
              data-urls="{{order.proofUrls}}"
              data-idx="{{pix}}"
            />
          </view>
        </scroll-view>
      </view>

      <!-- 管理员专属：老板联系方式 -->
      <view class="card" wx:if="{{isAdmin && order.boss_snapshot}}">
        <text class="t2 sm sec-title">玩家联系方式（仅管理员可见）</text>
        <view class="info-row">
          <text class="t2 sm">昵称</text>
          <text class="sm">{{order.boss_snapshot.nickname || '—'}}</text>
        </view>
        <block wx:if="{{order.boss_snapshot.contact}}">
          <view class="divider"/>
          <view class="info-row">
            <text class="t2 sm">微信 / 手机</text>
            <view class="contact-copy" catchtap="onCopyContact" data-contact="{{order.boss_snapshot.contact}}">
              <view class="wx-icon"><text class="wx-icon-text">微</text></view>
              <text class="sm" style="margin-left:10rpx;flex:1">{{order.boss_snapshot.contact}}</text>
              <text class="t3 xs" style="color:var(--primary)">复制</text>
            </view>
          </view>
        </block>
        <block wx:else>
          <view class="divider"/>
          <view class="info-row">
            <text class="t2 sm">微信 / 手机</text>
            <text class="t3 xs" style="color:var(--text-3)">未填写</text>
          </view>
        </block>
      </view>

      <!-- 进度日志 -->
      <view class="card">
        <text class="t2 sm sec-title">订单进度</text>
        <view wx:if="{{logs.length}}" class="log-list">
          <view wx:for="{{logs}}" wx:key="_id" class="log-item">
            <view class="log-dot"/>
            <view class="log-body">
              <view class="row-between"><text class="sm bold">{{item.action}}</text><text class="t3 xs">{{item.timeStr}}</text></view>
              <text class="t2 sm" style="margin-top:6rpx;line-height:1.5;display:block">{{item.content}}</text>
              <scroll-view wx:if="{{item.images.length}}" scroll-x style="margin-top:12rpx">
                <view style="display:inline-flex;gap:12rpx">
                  <image wx:for="{{item.images}}" wx:key="*this" wx:for-item="img" src="{{img}}" style="width:160rpx;height:160rpx;border-radius:8rpx;flex-shrink:0" mode="aspectFill" bindtap="previewImg" data-urls="{{item.images}}" data-idx="{{index}}"/>
                </view>
              </scroll-view>
            </view>
          </view>
        </view>
        <view wx:else class="empty" style="padding:32rpx 0">
          <text class="empty-icon" style="font-size:48rpx">⏳</text>
          <text class="sm" wx:if="{{order.status==='pending_payment'}}">完成支付后订单将进入待接单</text>
          <text class="sm" wx:else>等待陪玩师接单...</text>
        </view>
      </view>
      <view style="height:180rpx"/>
    </view>
  </scroll-view>

  <!-- 待付款底部栏 -->
  <view class="bottom-bar" wx:if="{{order&&order.status==='pending_payment'}}">
    <button class="btn btn-primary" style="width:100%" bindtap="goPay">立即支付 {{order.totalZb}} 总裁贝</button>
    <button class="btn btn-danger" style="width:100%;height:80rpx;font-size:24rpx;margin-top:12rpx" bindtap="onCancel">取消订单</button>
  </view>

  <!-- 管理员：待审核 -->
  <view class="bottom-bar bottom-bar--row" wx:if="{{order && order.status==='pending_settlement' && isAdmin}}">
    <button class="btn btn-primary flex1" catchtap="adminConfirmSettlement">确认完成</button>
    <button class="btn btn-danger flex1" catchtap="adminRejectSettlement">驳回</button>
  </view>
</view>
