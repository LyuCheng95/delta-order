/* ── Page ── */
.page { background: var(--bg-base); height: 100vh; display: flex; flex-direction: column; box-sizing: border-box; }

/* ── Header ── */
.hdr {
  flex-shrink: 0;
  background: var(--bg-card);
  border-bottom: 1rpx solid var(--border);
  padding: 0 32rpx 20rpx;
}
.hdr-row { display: flex; align-items: center; justify-content: space-between; }
.hdr-side { width: 120rpx; display: flex; align-items: center; }
.hdr-side-right { justify-content: flex-end; }
.back-link { font-size: 26rpx; color: var(--primary); font-weight: 600; }
.back-link:active { opacity: .7; }
.settings-btn { font-size: 40rpx; line-height: 1; padding: 8rpx; }
.settings-btn:active { opacity: .7; }
.hdr-title { flex: 1; text-align: center; font-size: 32rpx; font-weight: 700; color: var(--text-1); }

/* ── Tab nav ── */
.tab-bar {
  flex-shrink: 0; display: flex;
  background: var(--bg-card);
  border-bottom: 1rpx solid var(--border);
  padding: 0 8rpx;
}
.tab-item {
  flex: 1; display: flex; align-items: center; justify-content: center;
  height: 88rpx; font-size: 26rpx; color: var(--text-3);
  border-bottom: 4rpx solid transparent;
  position: relative; gap: 6rpx;
}
.tab-active { color: var(--primary); border-bottom-color: var(--primary); font-weight: 700; }
.tab-badge {
  background: var(--red); color: #fff;
  font-size: 18rpx; font-weight: 700; line-height: 1;
  min-width: 32rpx; height: 32rpx; border-radius: 999rpx;
  padding: 0 8rpx; display: flex; align-items: center; justify-content: center;
}

/* ── Scrollable content ── */
.tab-scroll { flex: 1; min-height: 0; }
.pad { padding: 32rpx; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 16rpx; }

/* ── Sub tab bar ── */
.sub-tab-bar {
  flex-shrink: 0; display: flex; gap: 12rpx;
  padding: 16rpx 32rpx; background: var(--bg-elevated);
  border-bottom: 1rpx solid var(--border-light);
}
.sub-tab {
  flex: 1; display: flex; align-items: center; justify-content: center;
  height: 64rpx; border-radius: 12rpx;
  font-size: 24rpx; color: var(--text-3); font-weight: 500;
}
.sub-tab:active { background: var(--bg-hover); }
.sub-active { background: rgba(0,229,255,.12); color: var(--primary); font-weight: 700; }

/* ── Order card ── */
.order-card:active { background: var(--bg-hover); }
.btn-sm::after { border: none; }
.divider { height: 1rpx; background: var(--border); }
.row-between { display: flex; align-items: center; justify-content: space-between; }

/* ── Skeleton ── */
.skeleton-card { height: 160rpx; background: linear-gradient(90deg,#1A1D27 25%,#22263A 50%,#1A1D27 75%); background-size: 400% 100%; animation: sh 1.5s infinite; border-radius: 24rpx; }
@keyframes sh { 0% { background-position: 100% 0 } 100% { background-position: -100% 0 } }

/* ── 资金 tab ── */
.hero-card { padding: 36rpx; }
.hero-amt { display: block; font-size: 72rpx; font-weight: 700; color: var(--primary); margin: 12rpx 0 24rpx; letter-spacing: -2rpx; }
.stats-row { display: flex; align-items: center; }
.stat-item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.stat-val { font-size: 30rpx; font-weight: 700; }
.stat-div { width: 1rpx; height: 48rpx; background: var(--border); }
.section-label { font-size: 24rpx; color: var(--text-3); padding: 8rpx 4rpx 4rpx; margin-top: 8rpx; }
.form-card { display: flex; flex-direction: column; }
.form-label { font-size: 26rpx; color: var(--text-2); margin-bottom: 12rpx; display: block; }
.input-row { display: flex; align-items: center; gap: 16rpx; }
.input-field { background: var(--bg-base); border: 1rpx solid var(--border); border-radius: 12rpx; padding: 20rpx 24rpx; color: var(--text-1); font-size: 28rpx; width: 100%; box-sizing: border-box; }
.link-btn { white-space: nowrap; color: var(--primary); font-size: 26rpx; font-weight: 600; }
.hint-text { font-size: 22rpx; color: var(--text-3); margin-top: 12rpx; line-height: 1.5; }

/* 提现记录 */
.rec-card { padding: 24rpx 32rpx; }

/* ── 空状态 ── */
.empty { display: flex; flex-direction: column; align-items: center; gap: 16rpx; padding: 80rpx 0; color: var(--text-3); }
.empty-icon { font-size: 80rpx; line-height: 1; }

/* ── Designated order ── */
.order-card--designated {
  border: 1rpx solid rgba(255, 200, 0, .4);
}
.designated-badge {
  background: rgba(255,200,0,.15); border: 1rpx solid rgba(255,200,0,.4);
  border-radius: 999rpx; padding: 4rpx 14rpx;
  font-size: 22rpx; color: #ffd700; white-space: nowrap; flex-shrink: 0;
}
.reject-btn {
  background: rgba(255,80,80,.12); border: 1rpx solid rgba(255,80,80,.3);
  border-radius: 999rpx; padding: 8rpx 20rpx;
  font-size: 24rpx; color: #ff6b6b;
}
.reject-btn:active { opacity: .75; }

.profile-link { font-size: 26rpx; color: var(--primary); }

.profile-banner {
  margin: 12rpx 24rpx 0;
  background: rgba(255,200,0,.1); border: 1rpx solid rgba(255,200,0,.3);
  border-radius: 16rpx; padding: 20rpx 24rpx;
}
.profile-banner:active { opacity: .8; }

.settings-entry:active { opacity: .8; }

.settings-profile-row {
  display: flex; align-items: center; gap: 24rpx;
}
.settings-avatar-wrap { flex-shrink: 0; }
.settings-avatar {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  border: 2rpx solid rgba(255,255,255,.15);
}
.settings-profile-info { flex: 1; min-width: 0; }
.settings-profile-hint { margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid var(--border-light); }
