.page{background:var(--bg-base);height:100%;min-height:0;display:flex;flex-direction:column;overflow:hidden;box-sizing:border-box;}
.detail-scroll{flex:1;min-height:0;}
.content{padding:32rpx;display:flex;flex-direction:column;gap:16rpx;}
.status-hero{background:var(--bg-card);border:1rpx solid var(--border);border-radius:24rpx;padding:48rpx 32rpx;display:flex;flex-direction:column;align-items:center;gap:12rpx;}
.status-dot{width:24rpx;height:24rpx;border-radius:50%;}
.dot-paid{background:#00E5FF;box-shadow:0 0 12rpx #00E5FF;}
.dot-in_progress{background:#FF8C00;box-shadow:0 0 12rpx #FF8C00;}
.dot-pending_settlement{background:#FFB800;box-shadow:0 0 12rpx #FFB800;}
.dot-completed{background:#00D68F;box-shadow:0 0 12rpx #00D68F;}
.sec-title{display:block;margin-bottom:16rpx;}
.info-row{display:flex;align-items:flex-start;justify-content:space-between;padding:12rpx 0;gap:12rpx;}
.log-list{display:flex;flex-direction:column;}
.log-item{display:flex;gap:16rpx;padding:12rpx 0;position:relative;}
.log-item:not(:last-child):before{content:'';position:absolute;left:11rpx;top:36rpx;bottom:0;width:2rpx;background:var(--border);}
.log-dot{width:24rpx;height:24rpx;border-radius:50%;background:var(--primary);flex-shrink:0;margin-top:8rpx;}
.log-body{flex:1;}
.bottom-bar{position:fixed;bottom:0;left:0;right:0;background:var(--bg-card);border-top:1rpx solid var(--border);padding:16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));display:flex;gap:16rpx;}
.tip-bar{position:fixed;bottom:0;left:0;right:0;background:rgba(26,29,39,.96);border-top:1rpx solid var(--border);padding:20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));text-align:center;}
.proof-scroll{width:100%;white-space:nowrap;}
.proof-row{display:inline-flex;gap:12rpx;}
.proof-thumb{width:200rpx;height:200rpx;border-radius:12rpx;flex-shrink:0;}
.btn::after{border:none;}
.chat-entry{display:flex;align-items:center;justify-content:space-between;cursor:pointer;}
.chat-entry:active{opacity:.75;}
.chat-entry-left{display:flex;align-items:center;gap:20rpx;}
.co-badge{font-size:20rpx;color:#FF8C00;background:rgba(255,140,0,.15);border:1rpx solid rgba(255,140,0,.35);border-radius:8rpx;padding:2rpx 10rpx;flex-shrink:0;}

.mask{position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:1000;}
.sheet{position:fixed;bottom:0;left:0;right:0;background:#1A1D27;border-radius:24rpx 24rpx 0 0;padding:40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));z-index:1001;transform:translateY(100%);transition:transform .3s;}
.sheet-show{transform:translateY(0);}
.partner-row{display:flex;align-items:center;padding:16rpx 20rpx;border-radius:12rpx;margin-bottom:8rpx;background:rgba(255,255,255,.04);}
.partner-row:active{background:rgba(255,255,255,.08);}
.partner-selected{background:rgba(0,229,255,.1);border:1rpx solid rgba(0,229,255,.3);}

.reservation-card { border: 1rpx solid rgba(255,215,0,.25); }
