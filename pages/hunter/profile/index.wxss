.profile-scroll { height: 100vh; }
.page { background: var(--bg-base); min-height: 100%; padding: 24rpx 32rpx; box-sizing: border-box; }

/* ── completeness checklist ── */
.checklist-card {
  background: var(--bg-card); border-radius: 20rpx;
  padding: 24rpx 28rpx; margin-bottom: 20rpx;
  border: 1rpx solid var(--border);
}
.checklist-header {
  display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx;
}
.ready-badge {
  font-size: 22rpx; color: #4cd964;
  background: rgba(76,217,100,.12); border-radius: 999rpx; padding: 4rpx 16rpx;
}
.pending-badge {
  font-size: 22rpx; color: #ffcc00;
  background: rgba(255,204,0,.12); border-radius: 999rpx; padding: 4rpx 16rpx;
}
.checklist-items { display: flex; gap: 28rpx; }
.check-item { display: flex; align-items: center; gap: 8rpx; }
.check-icon { font-size: 24rpx; color: var(--text-3); font-weight: 700; }
.check-icon.done { color: #4cd964; }
.check-label { font-size: 24rpx; color: var(--text-3); }
.check-label.done { color: var(--text-1); }

/* ── hero card ── */
.hero-card {
  display: flex; align-items: center; gap: 28rpx;
  background: var(--bg-card); border-radius: 24rpx;
  padding: 32rpx; margin-bottom: 20rpx;
}
.avatar-wrap { position: relative; width: 112rpx; height: 112rpx; flex-shrink: 0; }
.avatar-wrap:active { opacity: .8; }
.avatar { width: 112rpx; height: 112rpx; border-radius: 50%; border: 3rpx solid rgba(255,255,255,.25); }
.avatar-overlay {
  position: absolute; bottom: 0; right: 0;
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: rgba(0,0,0,.65); border: 2rpx solid rgba(255,255,255,.2);
  display: flex; align-items: center; justify-content: center;
}
.avatar-cam { font-size: 22rpx; }
.hero-info { flex: 1; min-width: 0; }
.name-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 10rpx; }
.name-edit-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 10rpx; }
.hero-name { font-size: 34rpx; }
.nick-input {
  flex: 1; height: 64rpx; font-size: 28rpx; color: var(--text-1);
  background: var(--bg-elevated); border-radius: 12rpx;
  padding: 0 16rpx; box-sizing: border-box; border: 1rpx solid var(--border);
}
.hero-stats { display: flex; align-items: center; gap: 12rpx; }
.stat-item { font-size: 24rpx; color: var(--text-2); }
.stat-sep  { color: var(--text-3); font-size: 22rpx; }

/* ── required marker ── */
.required { color: var(--red); font-size: 24rpx; }

/* ── save hint ── */
.save-hint {
  display: block; text-align: center;
  font-size: 22rpx; color: var(--text-3); margin-top: 12rpx;
}
.btn-disabled {
  background: var(--bg-elevated); color: var(--text-3); border-radius: 999rpx;
  height: 88rpx; display: flex; align-items: center; justify-content: center;
  font-size: 30rpx;
}

/* ── section card ── */
.section-card {
  background: var(--bg-card); border-radius: 24rpx;
  padding: 28rpx 32rpx; margin-bottom: 20rpx;
}
.section-title-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.section-title { font-size: 28rpx; font-weight: 700; color: var(--text-1); }
.char-count { font-size: 22rpx; color: var(--text-3); }

/* ── inputs ── */
.profile-textarea {
  width: 100%; min-height: 120rpx; font-size: 28rpx;
  color: var(--text-1); line-height: 1.7;
  background: var(--bg-elevated); border-radius: 16rpx;
  padding: 20rpx 24rpx; box-sizing: border-box;
  border: 1rpx solid var(--border);
}
.profile-input {
  width: 100%; height: 80rpx; font-size: 28rpx;
  color: var(--text-1); background: var(--bg-elevated);
  border-radius: 16rpx; padding: 0 24rpx; box-sizing: border-box;
  border: 1rpx solid var(--border);
}

/* ── portfolio ── */
.portfolio-grid {
  display: flex; flex-wrap: wrap; gap: 16rpx;
}
.portfolio-item {
  position: relative; width: 192rpx; height: 192rpx;
}
.portfolio-img {
  width: 100%; height: 100%; border-radius: 16rpx; display: block;
}
.portfolio-del {
  position: absolute; top: -12rpx; right: -12rpx;
  width: 44rpx; height: 44rpx; border-radius: 50%;
  background: rgba(0,0,0,.7); color: #fff;
  font-size: 22rpx; display: flex; align-items: center; justify-content: center;
  border: 2rpx solid rgba(255,255,255,.3);
}
.portfolio-add {
  width: 192rpx; height: 192rpx; border-radius: 16rpx;
  border: 2rpx dashed var(--border);
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx;
}
.portfolio-add:active { background: var(--bg-elevated); }
.portfolio-add-icon { font-size: 56rpx; color: var(--text-3); line-height: 1; }

/* ── service picker ── */
.cat-block { margin-bottom: 4rpx; }
.cat-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 0; border-bottom: 1rpx solid var(--border-light);
}
.cat-header:active { opacity: .7; }
.cat-arrow {
  font-size: 32rpx; color: var(--text-3);
  display: inline-block; transition: transform 0.2s;
}
.cat-arrow--open { transform: rotate(90deg); }
.svc-list { padding: 8rpx 0 8rpx 32rpx; }
.svc-row {
  display: flex; align-items: center; gap: 20rpx;
  padding: 16rpx 0; border-bottom: 1rpx solid var(--border-light);
}
.svc-row:last-child { border-bottom: none; }
.svc-row:active { opacity: .7; }
.svc-check {
  width: 40rpx; height: 40rpx; border-radius: 8rpx; flex-shrink: 0;
  border: 2rpx solid var(--border);
  display: flex; align-items: center; justify-content: center;
}
.svc-check--on { background: var(--primary); border-color: var(--primary); }
.svc-tick { font-size: 24rpx; color: #0A0E18; font-weight: 700; }

/* ── account info ── */
.info-row { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; }
.divider { height: 1rpx; background: var(--border-light); }
.edit-link { font-size: 24rpx; color: var(--primary); }

/* ── bottom links ── */
.bottom-links {
  display: flex; align-items: center; justify-content: center;
  gap: 0; margin: 8rpx 0 24rpx;
}
.bottom-link {
  flex: 1; text-align: center; font-size: 26rpx;
  color: var(--text-2); padding: 16rpx 0;
}
.bottom-link:active { opacity: .6; }
.bottom-link.danger { color: var(--red); }
.bottom-link-sep { width: 1rpx; height: 32rpx; background: var(--border); flex-shrink: 0; }
