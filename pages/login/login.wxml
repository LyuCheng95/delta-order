<view class="page">
  <view class="glow"/>
  <view class="logo">
    <text class="logo-tri">△</text>
    <text class="logo-title">上总裁电竞</text>
    <text class="logo-sub t3 sm">你的专属陪玩</text>
  </view>

  <!-- 正常加载 -->
  <view class="loading-wrap" wx:if="{{!errMsg}}">
    <view class="loading-ring"/>
    <text class="t2 sm" style="margin-top:24rpx">正在登录...</text>
  </view>

  <!-- 登录失败，显示错误和重试 -->
  <view class="error-wrap" wx:else>
    <text class="err-icon">⚠️</text>
    <text class="err-title t2">登录失败</text>
    <text class="err-msg t3 sm">{{errMsg}}</text>
    <view class="retry-btn" bindtap="onRetry">重新登录</view>
  </view>
</view>
