<view class="tabbar">
  <view class="tabbar-glow" />
  <view class="tabbar-row">
    <view
      wx:for="{{tabs}}"
      wx:key="path"
      wx:if="{{!item.hunterOnly || showHunterTab}}"
      class="tab-item {{selected === index ? 'active' : ''}}"
      bindtap="switchTab"
      data-index="{{index}}"
      data-path="{{item.path}}"
      hover-class="tab-item--hover"
      hover-stay-time="60"
    >
      <view class="tab-label-wrap">
        <text class="tab-text">{{item.label}}</text>
        <!-- Unread dot on 消息 tab (index 2) -->
        <view wx:if="{{index === 2 && hasUnread}}" class="unread-dot"/>
      </view>
      <view class="tab-indicator" wx:if="{{selected === index}}" />
    </view>
  </view>
</view>
