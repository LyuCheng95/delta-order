<view class="tabbar">
  <view class="tabbar-glow" />
  <view class="tabbar-row">
    <view
      wx:for="{{tabs}}"
      wx:key="path"
      wx:if="{{!item.hunterOnly || isHunter}}"
      class="tab-item {{selected === item.path ? 'active' : ''}}"
      bindtap="switchTab"
      data-path="{{item.path}}"
      hover-class="tab-item--hover"
      hover-stay-time="60"
    >
      <view class="tab-label-wrap">
        <text class="tab-text">{{item.label}}</text>
        <view wx:if="{{item.path === '/pages/boss/orders/index' && hasUnread}}" class="unread-dot"/>
      </view>
      <view class="tab-indicator" wx:if="{{selected === item.path}}" />
    </view>
  </view>
</view>
