/* 安全区：底部仅留白给 Home Indicator，可点击区在 tabbar-row 内 */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  box-sizing: border-box;
  background: rgba(15, 17, 23, 0.92);
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  box-shadow: 0 -12rpx 48rpx rgba(0, 0, 0, 0.45);
}

.tabbar-glow {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 1rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(0, 229, 255, 0.35) 50%,
    transparent 100%
  );
  pointer-events: none;
}

.tabbar-row {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  justify-content: space-around;
  min-height: 96rpx;
  padding: 12rpx 24rpx 16rpx;
  box-sizing: border-box;
}

.tab-item {
  flex: 1;
  max-width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  position: relative;
  border-radius: 20rpx;
  margin: 0 6rpx;
  transition: background 0.2s ease, transform 0.15s ease;
}

.tab-item--hover {
  opacity: 0.92;
}

.tab-item.active {
  background: rgba(0, 229, 255, 0.1);
}

.tab-text {
  font-size: 26rpx;
  line-height: 1.25;
  color: #5a6080;
  font-weight: 500;
  letter-spacing: 0.5rpx;
  transition: color 0.2s ease, font-weight 0.2s ease;
}

.tab-item.active .tab-text {
  color: #00e5ff;
  font-weight: 700;
  text-shadow: 0 0 24rpx rgba(0, 229, 255, 0.35);
}

/* 指示条贴在文字右下方，不伸进安全区 */
.tab-indicator {
  width: 36rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #00e5ff, #00b8cc);
  box-shadow: 0 0 12rpx rgba(0, 229, 255, 0.5);
}
